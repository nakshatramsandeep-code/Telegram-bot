# ── Telegram ──────────────────────────────────────────────────────────────────
# Your bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Optional: restrict the bot to a single chat ID (get it via @userinfobot)
# Leave blank to accept messages from any chat.
AUTHORIZED_TELEGRAM_CHAT_ID=

# ── LLM ───────────────────────────────────────────────────────────────────────
# Provider: anthropic | openai | gemini
LLM_PROVIDER=anthropic

# API key for the chosen provider
LLM_API_KEY=your_llm_api_key_here

# Model to use (defaults: claude-opus-5-5 / gpt-4o / gemini-2.5-flash)
LLM_MODEL=claude-opus-5-5

# ── Voice reference ───────────────────────────────────────────────────────────
# Path to voice.txt (default: voice.txt in the project root)
VOICE_FILE_PATH=voice.txt
